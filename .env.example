# Gemini on Vertex AI (same project as edbard)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Models
# Research + writing model (default when you just press Enter in the menu) and the models offered
WRITER_MODEL=gemini-4-argon
WRITER_MODELS=gemini-4-argon,gemini-3.8-flash,gemini-3.7-flash
# Looks at your own images
VISION_MODEL=gemini-3.8-flash
# Fixes broken JSON answers
REPAIR_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Voice: picked per video in the CLI; ElevenLabs is offered when a key is set
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE=KxR7w7QY9Rc4gig86VPG

# Optional
# MAX_IMAGES=6
# MUSIC_VOLUME=0.08
# TTS_CONCURRENCY=4
